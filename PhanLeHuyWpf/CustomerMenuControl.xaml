<UserControl x:Class="PhanLeHuyWpf.CustomerMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PhanLeHuyWpf"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Name="mnuAccount" Header="Account" Click="mnuAccount_Click"/>
            <MenuItem Name="mnuOrders" Header="Orders" Click="mnuOrders_Click"/>
            <MenuItem Name="mnuLogout" Header="Logout" Click="mnuLogout_Click"/>
        </Menu>
    </DockPanel>
</UserControl>
