<Window x:Class="PhanLeHuyWpf.CustomerManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhanLeHuyWpf"
        mc:Ignorable="d"
        Title="CustomerManagement" Height="450" Width="800">
    <Grid>
        <ListView x:Name="lvCustomer" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,20,0,81">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ma khach hang" DisplayMemberBinding="{Binding CustomerId}"/>
                    <GridViewColumn Header="Ten cong ty" DisplayMemberBinding="{Binding CompanyName}"/>
                    <GridViewColumn Header="Ten lien lac" DisplayMemberBinding="{Binding ContactName}"/>
                    <GridViewColumn Header="Tieu de lien lac" DisplayMemberBinding="{Binding ContactTitle}"/>
                    <GridViewColumn Header="Dia chi" DisplayMemberBinding="{Binding Address}"/>
                    <GridViewColumn Header="So dien thoai" DisplayMemberBinding="{Binding Phone}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="btnAddCustomer" Content="Add Customer" HorizontalAlignment="Left" Margin="30,0,0,20" VerticalAlignment="Bottom" Width="101" Click="btnAddCustomer_Click"/>
        <Button x:Name="btnRemoveCustomer" Content="Remove Customer" HorizontalAlignment="Left" Margin="272,0,0,20" VerticalAlignment="Bottom"  Click="btnRemoveCustomer_Click"/>
        <Button x:Name="btnUpdateCustomer" Content="Update Customer" HorizontalAlignment="Left" Margin="153,0,0,20" VerticalAlignment="Bottom"  Width="101" Click="btnUpdateCustomer_Click"/>
        <Label Content="Ma khach hang:" HorizontalAlignment="Left" Margin="414,0,0,20" VerticalAlignment="Bottom" />
        <TextBox x:Name="txtCustomerId_Search" HorizontalAlignment="Left" Margin="515,0,0,20"  TextWrapping="Wrap" VerticalAlignment="Bottom" Width="120"/>
        <Label Content="Search Customer" HorizontalAlignment="Left" Margin="414,0,0,50" VerticalAlignment="Bottom"  Width="149" FontWeight="Bold"/>
        <Button x:Name="btnSearch" Content="Search" HorizontalAlignment="Left" Margin="651,0,0,20" VerticalAlignment="Bottom"  Width="74" Click="btnSearch_Click"/>
    </Grid>
</Window>
